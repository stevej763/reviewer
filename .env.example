# Everything here is optional. Your name, PIN and AI model are set in the app's
# first-time setup screen; the AI values below only pre-fill that screen.

# Pre-fills for the setup screen
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:8b
# ANTHROPIC_API_KEY=

# Speech to text (runs in the container): tiny, base, small, medium, large-v3
# WHISPER_MODEL=small

# Set to true if you serve the app over HTTPS
# COOKIE_SECURE=false

# Port on this Mac
# REVIEWER_PORT=8000
