# Everything here is optional. Your name, PIN and AI model are set in the app's
# first-time setup screen; the AI values below only pre-fill that screen.

# Opts out of the startup password. If set, this IS the encryption key and the app
# starts unlocked, with the key in plain text here. Normally leave it unset: the app
# then asks for a startup password and keeps the key wrapped in the data volume.
# Ignored once a startup password exists.
# SECRET_KEY=

# Pre-fills for the setup screen
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:8b
# ANTHROPIC_API_KEY=

# Speech to text (runs in the container): tiny, base, small, medium, large-v3
# WHISPER_MODEL=small

# Set to true if you serve the app over HTTPS
# COOKIE_SECURE=false

# Port on this Mac
# REVIEWER_PORT=8000
