# --- Required -------------------------------------------------------------
# The PIN you type to unlock the app. Use 6+ digits.
APP_PIN=

# Encrypts your log at rest and signs logins. Generate one with:
#   openssl rand -base64 48
# Keep it safe and back it up: if you lose it, your stored entries can't be decrypted.
SECRET_KEY=

# --- AI models --------------------------------------------------------------
# Default model for summaries and reports: claude or ollama
LLM_PROVIDER=claude

# Claude (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking effort for daily summaries: low, medium, high (reports always use high)
ANTHROPIC_EFFORT=medium
# Retry on a fallback model if Claude declines a request
ANTHROPIC_FALLBACKS=true

# Ollama (optional). Use http://ollama:11434 with the compose "ollama" profile,
# or point at an Ollama you already run, e.g. http://192.168.1.20:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b

# --- Speech to text (runs locally) -----------------------------------------
# tiny, base, small, medium, large-v3, or distil-large-v3. small is a good CPU default.
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
WHISPER_COMPUTE_TYPE=int8

# --- Security ---------------------------------------------------------------
# Set to true once you serve the app over HTTPS (needed for the phone mic anyway)
COOKIE_SECURE=false
SESSION_DAYS=30
MAX_PIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Host port
REVIEWER_PORT=8000
